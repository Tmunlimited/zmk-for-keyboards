#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
// needed for mouse
#include <dt-bindings/zmk/pointing.h>
// needed for zip-scroll-scaler change 
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>


#define LAYER_Base 0
#define LAYER_System 1
#define LAYER_Symbol 2
#define LAYER_Navigation 3
#define LAYER_Number 4
#define LAYER_Function 5
#define LAYER_Typing 6
#define LAYER_Gaming 7
#define LAYER_Mouse 8
#define LAYER_MouseSlow 9
#define LAYER_MouseFast 10
#define LAYER_MouseWarp 11

/ {
    combos {
        compatible = "zmk,combos";

        gaming_toggle {
            bindings = <&tog 7>;
            key-positions = <51 58>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        LAYER_Base {
            bindings = <
&kp GRAVE  &kp N1          &kp N2          &kp N3       &kp N4            &kp N5                                       &kp N6           &kp N7             &kp N8       &kp N9          &kp N0         &kp MINUS
&kp TAB    &kp Q           &mt RALT W      &kp E        &kp R             &kp T                                        &kp Y            &kp U              &kp I        &mt RALT O      &kp P          &kp BSPC
&kp ESC    &mt LEFT_WIN A  &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G                                        &kp H            &mt RIGHT_SHIFT J  &mt RCTRL K  &mt LEFT_ALT L  &mt RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C        &kp V             &kp B        &kp C_MUTE     &rgb_ug RGB_TOG  &kp N            &kp M              &kp COMMA    &kp DOT         &kp FSLH       &kp RSHFT
                           &kp LGUI        &kp LALT     &lt 5 LALT        &lt 3 LCTRL  &lt 4 SPACE    &lt 8 ENTER      &lt 2 BACKSPACE  &lt 1 DELETE       &kp RALT     &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        LAYER_System {
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;
        };

        LAYER_Symbol {
            bindings = <
&kp DOUBLE_QUOTES  &kp GRAVE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI          &kp COMMA                      &kp GRAVE          &kp DEL       &kp LS(TAB)  &kp INS    &kp ESC   &none
&kp EXCL           &kp LBKT       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RBKT          &kp QUESTION                   &kp SQT            &kp BSPC      &kp TAB      &kp SPACE  &kp RET   &none
&kp POUND          &kp CARET      &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR        &kp ASTRK                      &kp DOUBLE_QUOTES  &kp RSHFT     &kp RCTRL    &kp LALT   &kp RGUI  &none
&kp TILDE          &kp LESS_THAN  &kp PIPE              &kp MINUS              &kp GREATER_THAN  &kp SLASH     &none     &none  &kp COMMA          &kp ASTERISK  &kp DOT      &kp FSLH   &kp BSLH  &none
                                  &kp AMPS              &kp COLON              &kp PERCENT       &kp BSLH      &kp AT    &none  &none              &none         &none        &none
            >;
        };

        LAYER_Navigation {
            bindings = <
&none  &kp ESCAPE    &kp INSERT    &kp LS(TAB)  &kp DELETE      &none                        &none        &none     &none     &none      &none      &none
&none  &kp ENTER     &kp SPACE     &kp TAB      &kp BACKSPACE   &kp K_CUT                    &kp K_CUT    &kp HOME  &kp UP    &kp END    &kp PG_UP  &none
&none  &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL    &kp LEFT_SHIFT  &kp K_COPY                   &kp K_COPY   &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &none
&none  &none         &none         &none        &none           &kp K_PASTE  &none    &none  &kp K_PASTE  &none     &none     &none      &none      &none
                     &none         &none        &none           &none        &none    &none  &none        &none     &none     &none
            >;
        };

        LAYER_Number {
            bindings = <
&none  &none     &none     &none      &none      &none                    &none   &none   &none   &none   &none         &none
&none  &none     &none     &none      &none      &none                    &none   &kp N7  &kp N8  &kp N9  &none         &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                    &none   &kp N4  &kp N5  &kp N6  &kp PLUS      &kp MINUS
&none  &none     &none     &none      &none      &none  &none    &none    &none   &kp N1  &kp N2  &kp N3  &kp ASTERISK  &kp SLASH
                 &none     &none      &none      &none  &none    &kp DOT  &kp N0  &none   &none   &none
            >;
        };

        LAYER_Function {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans                    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans    &trans    &trans     &trans     &trans                    &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F13
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans                    &trans  &kp F4  &kp F5  &kp F6  &kp F11  &kp F14
&trans  &trans    &trans    &trans     &trans     &trans  &trans    &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12  &kp F15
                  &trans    &trans     &trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER_Typing {
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4    &kp N5                                    &kp N6         &kp N7      &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W     &kp E     &kp R     &kp T                                     &kp Y          &kp U       &kp I      &kp O     &kp P     &kp BSPC
&kp ESC    &kp A   &kp S     &kp D     &kp F     &kp G                                     &kp H          &kp J       &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V     &kp B      &kp C_MUTE    &rgb_ug RGB_TOG  &kp N          &kp M       &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LALT  &kp LCTRL  &kp SPACE     &kp ENTER        &kp BACKSPACE  &kp DELETE  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        LAYER_Gaming {
            bindings = <
&kp ESCAPE  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                                           &kp N6         &kp N7   &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E   &kp R     &kp T                                            &kp Y          &kp U    &kp I      &kp O     &kp P     &kp BSPC
&kp CAPS    &kp A   &kp S   &kp D   &kp F     &kp G                                            &kp H          &kp J    &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C   &kp V     &kp B             &kp C_MUTE    &rgb_ug RGB_TOG  &kp N          &kp M    &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                    &kp M   &kp I   &kp LALT  &kp LEFT_CONTROL  &kp SPACE     &kp ENTER        &kp BACKSPACE  &kp DEL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        LAYER_Mouse {
            bindings = <
&none  &none           &none           &none           &none            &none                            &none        &none       &none      &none      &none     &none
&none  &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &kp K_CUT                        &kp K_CUT    &mkp LCLK   &mkp MCLK  &mkp RCLK  &mkp MB4  &none
&none  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp K_COPY                       &kp K_COPY   &mo 10      &mo 11     &mo 9      &mkp MB5  &none
&none  &none           &none           &mkp MB4        &mkp MB5         &kp K_PASTE  &none        &none  &kp K_PASTE  &kp LSHIFT  &kp LCTRL  &kp LALT   &kp LGUI  &none
                       &none           &none           &mkp MCLK        &mkp LCLK    &mkp RCLK    &none  &none        &none       &none      &none
            >;
        };

        LAYER_MouseSlow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER_MouseFast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER_MouseWarp {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    // ==== MOUSE-KEY <section starts> =====

    #define MOUSE_SCROLL_UP    SCRL_UP
    #define MOUSE_SCROLL_DOWN  SCRL_DOWN
    #define MOUSE_SCROLL_LEFT  SCRL_LEFT
    #define MOUSE_SCROLL_RIGHT SCRL_RIGHT

    // MOUSE_MOTION_DELAY defines how long to wait (milliseconds) before starting
    // to move the mouse pointer.
    #define MOUSE_MOTION_DELAY 0

    // MOUSE_MOTION_ACCELERATION_EXPONENT sets how the mouse pointer accelerates:
    //
    // acceleration exponent 0: uniform speed
    // acceleration exponent 1: uniform acceleration
    // acceleration exponent 2: uniform jerk
    //
    #define MOUSE_MOTION_ACCELERATION_EXPONENT 1

    // MOUSE_MOTION_TIME_TO_MAXIMUM_SPEED defines how long to wait (milliseconds)
    // before the mouse pointer speed is suddenly boosted to the maximum value.
    #define MOUSE_MOTION_TIME_TO_MAXIMUM_SPEED 300

    // MOUSE_MOTION_MAXIMUM_SPEED defines how quickly the mouse pointer can move.
    #define MOUSE_MOTION_MAXIMUM_SPEED 600

    // MOUSE_SCROLL_DELAY defines how long to wait (milliseconds) before starting
    // to move the mouse pointer.
    #define MOUSE_SCROLL_DELAY 0

    // MOUSE_SCROLL_ACCELERATION_EXPONENT sets how the mouse pointer accelerates:
    //
    // acceleration exponent 0: uniform speed
    // acceleration exponent 1: uniform acceleration
    // acceleration exponent 2: uniform jerk
    //
    #define MOUSE_SCROLL_ACCELERATION_EXPONENT 0

    // MOUSE_SCROLL_TIME_TO_MAXIMUM_SPEED defines how long to wait (milliseconds)
    // before the mouse pointer speed is suddenly boosted to the maximum value.
    #define MOUSE_SCROLL_TIME_TO_MAXIMUM_SPEED 300

    // MOUSE_SCROLL_MAXIMUM_SPEED defines how quickly the mouse wheel can scroll.
    #define MOUSE_SCROLL_MAXIMUM_SPEED 10

    // MOUSE_SCALER_SLOW sets parameters for the &zip_xy_scaler input processor:
    // https://zmk.dev/docs/keymaps/input-processors/scaler
    #define MOUSE_SCALER_SLOW 1 4

    // MOUSE_SCALER_FAST sets parameters for the &zip_xy_scaler input processor:
    #define MOUSE_SCALER_FAST 4 1

    // MOUSE_SCALER_WARP sets parameters for the &zip_xy_scaler input processor:
    #define MOUSE_SCALER_WARP 12 1
};

// ==== MOUSE-KEY <section begins> ====
#define ZMK_POINTING_DEFAULT_MOVE_VAL MOUSE_MOTION_MAXIMUM_SPEED
#define ZMK_POINTING_DEFAULT_SCRL_VAL MOUSE_SCROLL_MAXIMUM_SPEED

&mmv {
    delay-ms = <MOUSE_MOTION_DELAY>;
    acceleration-exponent = <MOUSE_MOTION_ACCELERATION_EXPONENT>;
    time-to-max-speed-ms = <MOUSE_MOTION_TIME_TO_MAXIMUM_SPEED>;
};

&msc {
    delay-ms = <MOUSE_SCROLL_DELAY>;
    acceleration-exponent = <MOUSE_SCROLL_ACCELERATION_EXPONENT>;
    time-to-max-speed-ms = <MOUSE_SCROLL_TIME_TO_MAXIMUM_SPEED>;
};

//
// Scaling for mouse movement, based on @caksoylar's example:
// https://github.com/caksoylar/zmk-config/commit/0020c23c544cd7111013f0114609d1fb90e0e475
//

&mmv_input_listener {
    #ifdef LAYER_MouseSlow

    slow {
        layers = <LAYER_MouseSlow>;
        input-processors = <&zip_xy_scaler MOUSE_SCALER_SLOW>;
    };

    #endif
    #ifdef LAYER_MouseFast

    fast {
        layers = <LAYER_MouseFast>;
        input-processors = <&zip_xy_scaler MOUSE_SCALER_FAST>;
    };

    #endif
    #ifdef LAYER_MouseWarp

    warp {
        layers = <LAYER_MouseWarp>;
        input-processors = <&zip_xy_scaler MOUSE_SCALER_WARP>;
    };

    #endif
};

//
// Scaling for mouse scrolling, based on @caksoylar's example:
// https://github.com/caksoylar/zmk-config/commit/e35ee2f08788927683df7bbdd7fc73434473886e
//

&zip_scroll_scaler {
    compatible = "zmk,input-processor-scaler";
    #input-processor-cells = <2>;
    type = <INPUT_EV_REL>;
    codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    track-remainders;
};

&msc_input_listener {
    #ifdef LAYER_MouseSlow

    slow {
        layers = <LAYER_MouseSlow>;
        input-processors = <&zip_scroll_scaler MOUSE_SCALER_SLOW>;
    };

    #endif
    #ifdef LAYER_MouseFast

    fast {
        layers = <LAYER_MouseFast>;
        input-processors = <&zip_scroll_scaler MOUSE_SCALER_FAST>;
    };

    #endif
    #ifdef LAYER_MouseWarp

    warp {
        layers = <LAYER_MouseWarp>;
        input-processors = <&zip_scroll_scaler MOUSE_SCALER_WARP>;
    };

    #endif
};

// ==== MOUSE-KEY <section ends> =====
