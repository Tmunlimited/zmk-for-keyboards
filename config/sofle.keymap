// needed for mouse
// needed for zip-scroll-scaler change 

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_Base 0
#define LAYER_System 1
#define LAYER_Symbol 2
#define LAYER_Navigation 3
#define LAYER_Number 4
#define LAYER_Function 5
#define LAYER_Typing 6
#define LAYER_Gaming 7
#define LAYER_Mouse 8
#define LAYER_MouseSlow 9
#define LAYER_MouseFast 10
#define LAYER_MouseWarp 11

/ {
    combos {
        compatible = "zmk,combos";

        gaming_toggle {
            bindings = <&tog 7>;
            key-positions = <51 58>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 19>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49>;
            hold-trigger-on-release;
        };

        thumb: thumb_layer_access {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
        };
    };
};

#include "mouse.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        LAYER_Base {
            bindings = <
&kp GRAVE  &kp N1           &kp N2           &kp N3        &kp N4             &kp N5                                             &kp N6              &kp N7              &kp N8        &kp N9           &kp N0          &kp MINUS
&kp TAB    &kp Q            &hml RALT W      &kp E         &kp R              &kp T                                              &kp Y               &kp U               &kp I         &hmr RALT O      &kp P           &kp BSPC
&kp ESC    &hml LEFT_WIN A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &kp G                                              &kp H               &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr LEFT_ALT L  &hmr RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z            &kp X            &kp C         &kp V              &kp B           &kp C_MUTE        &rgb_ug RGB_TOG  &kp N               &kp M               &kp COMMA     &kp DOT          &kp FSLH        &kp RSHFT
                            &kp LGUI         &kp LALT      &thumb 5 LALT      &thumb 3 SPACE  &thumb 4 LCTRL    &thumb 8 ENTER   &thumb 2 BACKSPACE  &thumb 1 DELETE     &kp RALT      &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        LAYER_System {
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;
        };

        LAYER_Symbol {
            bindings = <
&kp DOUBLE_QUOTES  &kp GRAVE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI          &kp COMMA                      &kp GRAVE          &kp DEL       &kp LS(TAB)  &kp INS    &kp ESC   &none
&kp EXCL           &kp LBKT       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RBKT          &kp QUESTION                   &kp SQT            &kp BSPC      &kp TAB      &kp SPACE  &kp RET   &none
&kp POUND          &kp CARET      &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR        &kp ASTRK                      &kp DOUBLE_QUOTES  &kp RSHFT     &kp RCTRL    &kp LALT   &kp RGUI  &none
&kp TILDE          &kp LESS_THAN  &kp PIPE              &kp MINUS              &kp GREATER_THAN  &kp SLASH     &none     &none  &kp COMMA          &kp ASTERISK  &kp DOT      &kp FSLH   &kp BSLH  &none
                                  &kp AMPS              &kp COLON              &kp PERCENT       &kp BSLH      &kp AT    &none  &none              &none         &none        &none
            >;
        };

        LAYER_Navigation {
            bindings = <
&none  &kp ESCAPE    &kp INSERT    &kp LS(TAB)  &kp DELETE      &none                      &none      &none     &none     &none      &none      &none
&none  &kp ENTER     &kp SPACE     &kp TAB      &kp BACKSPACE   &kp LC(X)                  &kp LC(X)  &kp HOME  &kp UP    &kp END    &kp PG_UP  &none
&none  &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL    &kp LEFT_SHIFT  &kp LC(C)                  &kp LC(C)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &none
&none  &none         &none         &none        &none           &kp LC(V)  &none    &none  &kp LC(V)  &none     &none     &none      &none      &none
                     &none         &none        &none           &none      &none    &none  &none      &none     &none     &none
            >;
        };

        LAYER_Number {
            bindings = <
&none  &none     &none     &none      &none      &none                    &none   &none   &none   &none   &none         &none
&none  &none     &none     &none      &none      &none                    &none   &kp N7  &kp N8  &kp N9  &none         &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                    &none   &kp N4  &kp N5  &kp N6  &kp PLUS      &kp MINUS
&none  &none     &none     &none      &none      &none  &none    &none    &none   &kp N1  &kp N2  &kp N3  &kp ASTERISK  &kp SLASH
                 &none     &none      &none      &none  &none    &kp DOT  &kp N0  &none   &none   &none
            >;
        };

        LAYER_Function {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans                    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans    &trans    &trans     &trans     &trans                    &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F13
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans                    &trans  &kp F4  &kp F5  &kp F6  &kp F11  &kp F14
&trans  &trans    &trans    &trans     &trans     &trans  &trans    &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12  &kp F15
                  &trans    &trans     &trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER_Typing {
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4    &kp N5                                    &kp N6         &kp N7      &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W     &kp E     &kp R     &kp T                                     &kp Y          &kp U       &kp I      &kp O     &kp P     &kp BSPC
&kp ESC    &kp A   &kp S     &kp D     &kp F     &kp G                                     &kp H          &kp J       &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V     &kp B      &kp C_MUTE    &rgb_ug RGB_TOG  &kp N          &kp M       &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LALT  &kp LCTRL  &kp SPACE     &kp ENTER        &kp BACKSPACE  &kp DELETE  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        LAYER_Gaming {
            bindings = <
&kp ESCAPE  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                                    &kp N6         &kp N7   &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E   &kp R     &kp T                                     &kp Y          &kp U    &kp I      &kp O     &kp P     &kp BSPC
&kp CAPS    &kp A   &kp S   &kp D   &kp F     &kp G                                     &kp H          &kp J    &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C   &kp V     &kp B      &kp C_MUTE    &rgb_ug RGB_TOG  &kp N          &kp M    &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                    &kp M   &kp I   &kp LALT  &kp SPACE  &kp LCTRL     &kp ENTER        &kp BACKSPACE  &kp DEL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        LAYER_Mouse {
            bindings = <
&none  &none           &none           &none           &none            &none                          &none      &none       &none      &none      &none     &none
&none  &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &kp LC(X)                      &kp LC(X)  &mkp LCLK   &mkp MCLK  &mkp RCLK  &mkp MB4  &none
&none  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LC(C)                      &kp LC(C)  &mo 10      &mo 11     &mo 9      &mkp MB5  &none
&none  &none           &none           &mkp MB4        &mkp MB5         &kp LC(V)  &none        &none  &kp LC(V)  &kp LSHIFT  &kp LCTRL  &kp LALT   &kp LGUI  &none
                       &none           &none           &mkp MCLK        &mkp LCLK  &mkp RCLK    &none  &none      &none       &none      &none
            >;
        };

        LAYER_MouseSlow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER_MouseFast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER_MouseWarp {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
